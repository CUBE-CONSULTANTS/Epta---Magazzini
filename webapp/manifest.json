{
  "_version": "1.65.0",
  "sap.app": {
    "id": "fdrevampxbrowser",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.16.3",
      "toolsId": "69951a3a-e57d-4a0b-9b70-0e18899704a1"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/SAP/Z_XBROWSER_RENEWAL_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.108.48",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "fdrevampxbrowser.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "useBatch": true
        }
  }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "fdrevampxbrowser.view",
        "async": true,
        "viewPath": "fdrevampxbrowser.view"
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": ":?query:",
          "target": [
            "TargetHome"
          ]
        },
        {
          "name": "Palletisation",
          "pattern": "Palletisation/{TYPE}",
          "target": [
            "Palletisation"
          ]
        },
        {
          "name": "TrasferimentoMagazzino",
          "pattern": "materiePrime/trasferimentoMagazzino",
          "target": [
            "TargetTrasferimentoMagazzino"
          ]
        }
      ],
      "targets": {
        "TargetHome": {
          "id": "Home",
          "name": "Home"
        },
        "Palletisation": {
          "id": "Palletisation",
          "name": "Palletisation"
        },
        "TargetTrasferimentoMagazzino": {
          "id": "TrasferimentoMagazzino",
          "name": "TrasferimentoMagazzino"
        }
      }
    },
    "rootView": {
      "viewName": "fdrevampxbrowser.view.App",
      "type": "XML",
      "id": "App"
    }
  }
}