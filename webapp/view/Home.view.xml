<mvc:View controllerName="fdrevampxbrowser.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m">

    <FlexBox direction="Row" width="100%" height="100%" class="fullScreenFlexBox">

        <!-- Sidebar -->
        <VBox renderType="Bare" alignItems="Start" width="auto" height="100%">
            <tnt:SideNavigation id="sideNavigation" selectedKey="walked" expanded="false" itemSelect="onItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Materie Prime" icon="sap-icon://building" selectable="true">
                        <tnt:NavigationListItem text="Pallettizzazione" />
                        <tnt:NavigationListItem text="Immagazzinare" />
                        <tnt:NavigationListItem text="Visualizzare funzioni WM" />
                        <tnt:NavigationListItem text="Trasferimenti interni" />
                        <tnt:NavigationListItem text="Trasf. ad alto magazzino" />
                        <tnt:NavigationListItem text="Consumo a centro costo" />
                        <tnt:NavigationListItem text="Parametrare stampante" />
                        <tnt:NavigationListItem text="Conto lavoro" />
                        <tnt:NavigationListItem text="Conferma lista prelievo" />
                    </tnt:NavigationListItem>
                    <tnt:NavigationListItem text="Semilavorati" icon="sap-icon://mileage" selectable="true"/>
                    <tnt:NavigationListItem text="Conferma di Produzione" icon="sap-icon://accept" selectable="true"/>
                    <tnt:NavigationListItem text="Production manual transfer" icon="sap-icon://shipping-status" selectable="true"/>
                </tnt:NavigationList>
                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem icon="sap-icon://menu2" text="Collapse/Expand" press="onCollapseExpandPress"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </VBox>


        <VBox width="100%" height="100%" alignItems="Center" justifyContent="Center" visible="{modello>/image}">
            <Image src="../public/Logo-epta.png" width="100%" height="100%" densityAware="false" decorative="false" />
        </VBox>

        <VBox width="100%" height="100%" alignItems="Stretch" justifyContent="Start" visible="{modello>/panel}">
            <Panel expandable="true" headerText="Pallettizzazione" width="auto" class="sapUiResponsiveMargin">
                <content>
                    <core:Fragment fragmentName="fdrevampxbrowser.view.Fragments.FirstStepWizard" type="XML" />
                </content>
            </Panel>

        </VBox>

    </FlexBox>

</mvc:View>
