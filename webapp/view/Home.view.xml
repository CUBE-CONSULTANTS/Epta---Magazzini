<mvc:View controllerName="fdrevampxbrowser.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Text text="{i18n>title}"/>
                </contentLeft>
                <contentRight>
                    <Image src="../public/Logo.jpg" height="30px" width="100px" visible="true" />
                </contentRight>
            </Bar>
        </customHeader>
        <VBox alignItems="Center" width="100%" class="sapUiMediumMarginTop">
            <items>
                <HBox alignItems="Stretch" width="100%" justifyContent="SpaceAround" class="sapUiTinyMarginEnd">
                    <items>
                        <l:Grid class="sapUiNoMarginTop" hSpacing="1" defaultSpan="L6 M6 S6">
                            <!-- Info Materiale -->
                            <VBox alignItems="Center" width="100%" height="auto" justifyContent="SpaceBetween">
                                <items>
                                    <GenericTile header="Materie Prime" press="onNavDetail">
                                        <TileContent>
                                            <ImageContent src="./resources/List.png" />
                                        </TileContent>
                                    </GenericTile>
                                </items>
                            </VBox>
                            <!-- New DDT -->
                            <VBox alignItems="Center" width="100%" height="auto" justifyContent="SpaceBetween">
                                <items>
                                    <GenericTile header="Semilavorati" press="onNavDetail">
                                        <TileContent>
                                            <ImageContent src="" />
                                        </TileContent>
                                    </GenericTile>
                                </items>
                            </VBox>
                        </l:Grid>
                    </items>
                </HBox>
            </items>
        </VBox>
        <!-- Seconda riga -->
        <VBox alignItems="Center" width="100%">
            <items>
                <HBox alignItems="Stretch" width="100%" justifyContent="SpaceAround" class="sapUiTinyMarginEnd">
                    <items>
                        <l:Grid class="sapUiNoMarginTop" hSpacing="1" defaultSpan="L6 M6 S6">
                            <!-- Prelievo -->
                            <VBox alignItems="Center" width="100%" height="105px" justifyContent="SpaceBetween">
                                <items>
                                    <GenericTile header="Conferma Produzione" press="onNavDetail">
                                        <TileContent>
                                            <ImageContent src="" />
                                        </TileContent>
                                    </GenericTile>
                                </items>
                            </VBox>
                            <!-- Rientro -->
                            <VBox alignItems="Center" width="100%" height="105px" justifyContent="SpaceBetween">
                                <items>
                                    <GenericTile header="Production manual transfer" press="onNavDetail">
                                        <TileContent>
                                            <ImageContent src="" />
                                        </TileContent>
                                    </GenericTile>
                                </items>
                            </VBox>
                        </l:Grid>
                    </items>
                </HBox>
            </items>
        </VBox>
