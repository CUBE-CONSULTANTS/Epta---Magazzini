<mvc:View controllerName="fdrevampxbrowser.controller.Pallettizzazione"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m">
    <NavContainer id="wizardNavContainer">
        <pages>
            <Page id="pageWizard">
                <customHeader>
                    <Bar>
                        <contentLeft>
                            <Button icon="sap-icon://nav-back" type="Transparent" press="onNavBack"/>
                            <Text text="Pallettizzazione"/>
                        </contentLeft>
                        <contentRight>
                            <Image src="../public/Logo.jpg" height="30px" width="100px" visible="true" />
                        </contentRight>
                    </Bar>
                </customHeader>
                <Wizard id="wizard" class="sapUiResponsivePadding--header sapUiResponsivePadding--content" complete="wizardCompletedHandler">
                    <WizardStep title="Pallettizzazione" validated="false" id="Pallettizzazione">
                        <core:Fragment fragmentName="fdrevampxbrowser.view.Fragments.FirstStepWizard" type="XML" />
                    </WizardStep>
                </Wizard>
            </Page>
            <Page id="wizardReviewPage" showHeader="true">
                <customHeader>
                    <Bar>
                        <contentLeft>
                            <Button icon="sap-icon://nav-back" type="Transparent" press="onNavBack"/>
                            <Text text="Conferma Pallettizzazione"/>
                        </contentLeft>
                        <contentRight>
                            <Image src="../public/Logo.jpg" height="30px" width="100px" visible="true" />
                        </contentRight>
                    </Bar>
                </customHeader>
                <content>
                    <core:Fragment fragmentName="fdrevampxbrowser.view.Fragments.ReviewWizard" type="XML" />

                </content>
                <footer>
                    <Bar>
                        <contentRight>
                            <Button text="Conferma" press="handleWizardSubmit"/>
                            <Button text="Annulla" press="handleWizardCancel"/>
                        </contentRight>
                    </Bar>
                </footer>
            </Page>
        </pages>
    </NavContainer>
</mvc:View>