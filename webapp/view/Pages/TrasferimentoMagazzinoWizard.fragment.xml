<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:unified="sap.ui.unified"
>
    <Page
        showHeader="true"
        enableScrolling="true"
        id="trasferimento_magazzino_wizard"
        showFooter="true"
    >
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press="onNavBack"
                    />
                    <Text text="Trasferimento Magazzino" />
                </contentLeft>
            </Bar>
        </customHeader>
        <content>
            <!-- <c:Fragment fragmentName="fdrevampxbrowser.view.Fragments.trasferimentoMagazzino.Step1"
                
                type="XML" />
            <c:Fragment fragmentName="fdrevampxbrowser.view.Fragments.trasferimentoMagazzino.Step2"
                binding="{trasferimentoMagazzino>/step2}"
                type="XML" />
                <c:Fragment fragmentName="fdrevampxbrowser.view.Fragments.trasferimentoMagazzino.Step3"
                binding="{trasferimentoMagazzino>/step3}"
                type="XML" />
                <c:Fragment fragmentName="fdrevampxbrowser.view.Fragments.trasferimentoMagazzino.Step4"
                binding="{trasferimentoMagazzino>/step4}"
                type="XML" /> -->
            <Wizard
                id="wizardTrasferimento"
                class="sapUiResponsivePadding--header sapUiResponsivePadding--content"
                complete="gnegne"
                renderMode="Page"
                finishButtonText="Invia"
                showNextButton="true"
            >
                <WizardStep
                    title="Trasferimento alla linea"
                    validated="false"
                    id="trasferimento_linea"
                >
                    <c:Fragment
                        fragmentName="fdrevampxbrowser.view.Fragments.trasferimentoMagazzino.Step1"
                        type="XML"
                    />
                </WizardStep>
                <WizardStep
                    title="Selezione magazzino di destinazione"
                    validated="false"
                    id="magazino_dest"
                >
                    <c:Fragment
                        fragmentName="fdrevampxbrowser.view.Fragments.trasferimentoMagazzino.Step2"
                        type="XML"
                    />
                </WizardStep>
                <WizardStep
                    title="Inserimento centro di costo"
                    validated="false"
                    id="centro_costo"
                >
                    <c:Fragment
                        fragmentName="fdrevampxbrowser.view.Fragments.trasferimentoMagazzino.Step3"
                        type="XML"
                    />
                </WizardStep>
                <WizardStep
                    title="Inserimento quantità"
                    validated="false"
                    id="quantita"
                >
                    <c:Fragment
                        fragmentName="fdrevampxbrowser.view.Fragments.trasferimentoMagazzino.Step4"
                        type="XML"
                    />
                </WizardStep>
            </Wizard>
        </content>
        <footer>
            <OverflowToolbar visible="false">
                <ToolbarSpacer />
                <Button
                    text="Salva"
                    type="Accept"
                    icon="sap-icon://save"
                />
                <Button
                    text="Annulla"
                    type="Reject"
                    icon="sap-icon://decline"
                    press="onNavBack"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</c:FragmentDefinition>
