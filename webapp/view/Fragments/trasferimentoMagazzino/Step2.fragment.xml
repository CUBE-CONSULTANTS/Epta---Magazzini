<c:FragmentDefinition xmlns="sap.m"
    xmlns:c="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.viz.ui5.core"
    xmlns:unified="sap.ui.unified">
    <FlexBox width="100%"
        direction="Column"
        visible="{trasferimentoMagazzino>enabled}">
        <f:SimpleForm editable="true"
            layout="ResponsiveGridLayout"
            title="2. Selezione magazzino di destinazione"
            labelSpanXL="3"
            labelSpanL="3"
            labelSpanM="3"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="4"
            emptySpanL="4"
            emptySpanM="4"
            emptySpanS="0"
            columnsXL="1"
            columnsL="1"
            columnsM="1"
            singleContainerFullSize="false">
            <f:content>
                <Label text="Materiale" />
                <Input editable="false"
                    value="{trasferimentoMagazzino>materiale/matnr} - {trasferimentoMagazzino>materiale/maktx}" />
            </f:content>
        </f:SimpleForm>
        <ScrollContainer vertical="true"
            width="100%"
            height="200px">
            <Table items="{trasferimentoMagazzino>list/items}"
                selectionChange=".onTMStep2SelectionChange"
                mode="SingleSelectLeft">
                <columns>
                    <Column>
                        <Label design="Bold"
                            text="Ubicazione" />
                    </Column>
                    <Column>
                        <Label design="Bold"
                            text="Stock" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Title class="sapUiTinyMarginEnd"
                                text="{trasferimentoMagazzino>vlpla}"
                                titleStyle="H4" />
                            <ObjectNumber number="{trasferimentoMagazzino>labst}"
                                unit="{trasferimentoMagazzino>meins}"
                                inverted="true"
                                state="Success" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </ScrollContainer>
    </FlexBox>
</c:FragmentDefinition>
