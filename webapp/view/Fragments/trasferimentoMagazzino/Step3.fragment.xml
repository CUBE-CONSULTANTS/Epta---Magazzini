<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.viz.ui5.core"
    xmlns:unified="sap.ui.unified"
>
    <f:SimpleForm
        editable="true"
        visible="true"
        layout="ResponsiveGridLayout"
        labelSpanXL="3"
        labelSpanL="3"
        labelSpanM="3"
        labelSpanS="12"
        adjustLabelSpan="false"
        emptySpanXL="4"
        emptySpanL="4"
        emptySpanM="4"
        emptySpanS="0"
        columnsXL="1"
        columnsL="1"
        columnsM="1"
        singleContainerFullSize="false"
    >
        <f:content>
            <Label
                design="Bold"
                required="true"
                text="Magazzino"
            />
            <Input
                editable="false"
                value="{modelloTransf>/Lgort} - {modelloTransf>/Lgtyp}"
            />

            <Label
                design="Bold"
                required="true"
                text="Materiale"
            />
            <Input
                editable="false"
                value="{modelloTransf>/Matnr} - {modelloTransf>/Maktx}"
            />

            <Label
                design="Bold"
                required="true"
                text="Ubicazione"
            />
            <Input
                editable="false"
                value="{modelloTransf>/Lgpla}"
            />

            <Label
                design="Bold"
                required="true"
                text="Trasferimento tra magazzini"
                visible="{= !${modelloTransf>/cdc} }"
            />
            <Input
                change=".onTMStep3Change"
                value="{modelloTransf>/new_mag}"
                id="new_mag"
                visible="{= !${modelloTransf>/cdc} }"
                type="Number"
                maxLength="4"
                liveChange="onTMStep3LiveChange"
            />

            <Label
                design="Bold"
                required="true"
                text="Centro di costo"
                visible="{modelloTransf>/cdc}"
            />
            <Input
                change=".onTMStep3Change"
                value="{modelloTransf>/new_mag}"
                id="new_mag2"
                visible="{modelloTransf>/cdc}"
            />
        </f:content>
    </f:SimpleForm>
    <!-- </VBox> -->
</c:FragmentDefinition>
