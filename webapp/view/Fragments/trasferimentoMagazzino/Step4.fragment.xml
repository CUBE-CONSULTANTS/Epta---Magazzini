<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.viz.ui5.core"
    xmlns:unified="sap.ui.unified"
>
    <f:SimpleForm
        editable="true"
        visible="true"
        layout="ResponsiveGridLayout"
        labelSpanXL="3"
        labelSpanL="3"
        labelSpanM="3"
        labelSpanS="12"
        adjustLabelSpan="false"
        emptySpanXL="4"
        emptySpanL="4"
        emptySpanM="4"
        emptySpanS="0"
        columnsXL="1"
        columnsL="1"
        columnsM="1"
        singleContainerFullSize="false"
    >
        <f:content>
            <Label
                design="Bold"
                required="true"
                text="Divisione"
            />
            <Input
                editable="false"
                value="{modelloTransf>/item/Lgnum}"
            />

            <Label
                design="Bold"
                required="true"
                text="Magazzino"
            />
            <Input
                editable="false"
                value="{modelloTransf>/Lgort}"
            />

            <Label
                design="Bold"
                required="true"
                text="Trasferimento tra magazzini"
            />
            <Input
                editable="false"
                value="{modelloTransf>/new_mag}"
            />

            <Label
                design="Bold"
                required="true"
                text="Materiale"
            />
            <Input
                editable="false"
                value="{modelloTransf>/Matnr} - {modelloTransf>/Maktx}"
            />

            <Label
                design="Bold"
                required="true"
                text="Stock Disponibili"
            />
            <Input
                editable="false"
                value="{modelloTransf>/item/VermeTxt}"
            />

            <Label
                design="Bold"
                required="true"
                text="Quantit&agrave;"
            />
            <Input
                change=".onTMStep4Change"
                editable="true"
                value="{modelloTransf>/quantity}"
                id="quantity"
                type="Number"
            />
        </f:content>
    </f:SimpleForm>
    <!-- </VBox> -->
</c:FragmentDefinition>
