<c:FragmentDefinition xmlns="sap.m"
    xmlns:c="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:unified="sap.ui.unified">
    <VBox >
        <form:SimpleForm title="1. Pallettizzazione" editable="false" layout="ResponsiveGridLayout">
            <form:content>
                <FlexBox justifyContent="SpaceAround">
                    <c:Fragment fragmentName="fdrevampxbrowser.view.Fragments.FirstStepWizard" type="XML" />
                    <Link press="goStepOne" text="Edit" />
                </FlexBox>
            </form:content>
        </form:SimpleForm>



        <form:SimpleForm editable="true" layout="ResponsiveGridLayout" title="2. Materiale" labelSpanXL="4" labelSpanL="4" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
            <form:content>
                <c:Title text=" " />
                <Label text="Materiale"/>
                <Text text="{modelloAppoggio>/Pallettizzazione/materiale}" />
                <Label text="Materiale"/>
                <Text text="{modelloAppoggio>/Pallettizzazione/descrizione_materiale}"/>
                <Label text="Stock Disp."/>
                <Text text="{modelloAppoggio>/Pallettizzazione/stock_dispo}"/>
                <Label text="Numero Magazzino"/>
                <Text text="{modelloAppoggio>/Pallettizzazione/numeroMagazzino}"/>
                <c:Title text="Quantità" />
                <Label text="Numero Etichette da stampare" wrapping="true"/>
                <StepInput value="{modelloAppoggio>/Pallettizzazione/numeroStampe}" min="0" step="1" width="20%" textAlign="Center" stepMode="AdditionAndSubtraction"/>
                <Label text="Simmetrico"/>
                <CheckBox selected="{modelloAppoggio>/Pallettizzazione/simmetrico}" />
                <Label text="Quantità"/>
                <Input value="{modelloAppoggio>/Pallettizzazione/quantità}"/>
                <Link press="goStepTwo" text="Edit" />
            </form:content>
        </form:SimpleForm>
